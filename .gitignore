# --- бинарники сборки (берите с архива релиза) ---
*.jar
*.jar.disabled
*.disabled
*.zip
*.7z
*.rar
*.ogg
*.mp3
*.wav
*.flac
# маленькие звуки, сделанные для сборки в KubeJS, — маленькие по размеру оставляем
!/minecraft/kubejs/assets/*/sounds/**/*.ogg
# кадры анимации главного меню (~100 МБ jpg) - берите с архива релиза
/minecraft/kubejs/assets/mc_cave_animation_*/

# --- рантайм игры ---
/minecraft/logs/
/minecraft/crash-reports/
/minecraft/saves/
/minecraft/screenshots/
/minecraft/backups/
